---
import Icon from "./Icon.astro";

interface Props {
  items: readonly string[];
  label?: string;
}

const { items, label = "HERRAMIENTAS" } = Astro.props;
const loop = [...items, ...items];
---

<div class="marquee" data-marquee>
  <div class="wrap marquee__head">
    <p class="label">{label}</p>
    <button
      class="marquee__toggle"
      type="button"
      data-marquee-toggle
      aria-pressed="false"
      aria-label="Pausar la marquesina de herramientas"
    >
      <span class="marquee__ico marquee__ico--pause"><Icon name="pause" size={12} /></span>
      <span class="marquee__ico marquee__ico--play"><Icon name="play" size={12} /></span>
      <span data-marquee-label>Pausar</span>
    </button>
  </div>
  <div class="marquee__viewport">
    <ul class="marquee__track" data-marquee-track>
      {loop.map((item, index) => (
        <li
          class:list={["marquee__item", index >= items.length && "marquee__item--dup"]}
          aria-hidden={index >= items.length ? "true" : undefined}
        >
          <span>{item}</span>
          <span class="marquee__dot" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </div>
</div>
