---
import type { CaseSlot } from "../content/site";
import { site, caseMailto } from "../content/site";
import Cover from "./Cover.astro";
import Icon from "./Icon.astro";

interface Props {
  item: CaseSlot;
  panel?: boolean;
}

const { item, panel = false } = Astro.props;
---

<article class:list={["case", `case--${item.index}`]} data-reveal={panel ? undefined : true}>
  {item.image ? (
    <div class="case__cover case__cover--image">
      <img
        class="case__image"
        src={item.image.src}
        alt={item.image.alt}
        width={item.image.width}
        height={item.image.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="case__cover">
      {item.cover && <Cover variant={item.cover} />}
    </div>
  )}
  <div class="case__body">
    <p class="case__meta mono">
      <span>{item.index} · {item.category}</span>
      <span class:list={["case__status", item.live && "is-prod"]}>{item.status}</span>
    </p>
    <h3 class="case__title">{item.title}</h3>
    {item.note && <p class="case__note">{item.note}</p>}
    <p class="case__summary">{item.summary}</p>
    {item.stack.length > 0 && (
      <ul class="case__stack">
        {item.stack.map((tech) => <li>{tech}</li>)}
      </ul>
    )}
    {item.confidential ? (
      <a class="case__cta case__cta--confidential" href={caseMailto(`${item.title} (NDA)`)}>
        <span>{site.work.ctaConfidential}</span>
        <Icon name="arrowRight" size={16} />
      </a>
    ) : (
      <a class="case__cta" href={caseMailto(item.title)}>
        <span>{site.work.cta}</span>
        <Icon name="arrowRight" size={16} />
      </a>
    )}
  </div>
</article>
