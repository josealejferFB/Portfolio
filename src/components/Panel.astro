---
interface Props {
  tone?: "verde" | "verde-900";
  shape?: "full" | "hero";
  class?: string;
}

const { tone = "verde", shape = "full", class: className } = Astro.props;
---

<div class:list={["panel", `panel--${tone}`, `panel--${shape}`, className]}>
  <span class="panel__rim" aria-hidden="true"></span>
  <span class="panel__fill" aria-hidden="true"></span>
  <div class="panel__inner">
    <slot />
  </div>
</div>
